% 2026-09-16 竞赛论文格式规范适配层。
% 保留上游 gmcmthesis.cls 原件；由 main.tex 在其后加载本文件。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{official-format-2026}[2026/09/25 GMCM 2026 official paper format]

\makeatletter
% 规范：摘要页是论文第一页，页脚中部连续使用阿拉伯数字；不放身份封面或页眉。
\renewcommand{\maketitle}{%
  \setcounter{page}{1}%
  \pagestyle{plain}%
  \thispagestyle{plain}%
  \begin{center}
    {\heiti\zihao{3}\@title\par}%
  \end{center}%
  \vspace{0.5\baselineskip}%
}
\renewenvironment{abstract}{%
  \begin{center}{\heiti\zihao{4}摘要\par}\end{center}%
  \noindent
}{\par\clearpage}
\renewcommand{\keywords}[1]{%
  \par\smallskip\noindent{\songti\zihao{-4}关键词：}#1\par
}

% 上游模板为 1.38 倍行距；规范指定小四宋体、单倍行距。
\renewcommand*{\baselinestretch}{1}
\AtBeginDocument{\songti\zihao{-4}\linespread{1}\selectfont\pagestyle{plain}}

% 一级标题沿用模板原有的四号黑体居中设置；其余中文标题用小四宋体。
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {1.25ex\@plus -1ex \@minus -.2ex}%
  {1.25ex \@plus .2ex}%
  {\normalfont\songti\zihao{-4}}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {1.25ex\@plus -1ex \@minus -.2ex}%
  {1.2ex \@plus .2ex}%
  {\normalfont\songti\zihao{-4}}}
\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}%
  {3.25ex \@plus1ex \@minus.2ex}%
  {-1em}%
  {\normalfont\songti\zihao{-4}}}
\renewcommand\subparagraph{\@startsection{subparagraph}{5}{\parindent}%
  {3.25ex \@plus1ex \@minus .2ex}%
  {-1em}%
  {\normalfont\songti\zihao{-4}}}
\makeatother
